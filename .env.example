# Environment Configuration

# ─── Required ───────────────────────────────────────────────────────────────

# Groq API key — get yours free at https://console.groq.com
GROQ_API_KEY=

# ─── Optional ────────────────────────────────────────────────────────────────

# Secret used to sign Bounded Intent Tokens (SHA-256).
# Defaults to "bit-demo-verifier-secret" if not set.
# Set this to a random string in any environment beyond local demo.
INTENT_TOKEN_SECRET=
